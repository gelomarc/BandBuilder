{
  "name": "bandbuilder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node tools/serve.mjs",
    "test": "vitest run",
    "fetch-data": "node tools/fetch-bsdata.mjs",
    "import-data": "node tools/import-bsdata.mjs",
    "icon": "node tools/make-icon.mjs",
    "app": "npm run build && electron .",
    "exe": "npm run build && npm run icon && electron-builder --win portable",
    "exe:setup": "npm run build && npm run icon && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "fast-xml-parser": "^4.5.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  },
  "description": "Builder drużyn do Shadow War: Armageddon — offline",
  "main": "electron/main.cjs",
  "author": {
    "name": "gelomarc"
  },
  "build": {
    "appId": "eu.gelomarc.bandbuilder",
    "productName": "BandBuilder",
    "copyright": "Dane systemu: BSData, społecznościowe, bez autoryzacji Games Workshop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "BandBuilder-${version}.exe"
    },
    "portable": {
      "artifactName": "BandBuilder-${version}.exe",
      "unicode": true
    },
    "nsis": {
      "artifactName": "BandBuilder-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BandBuilder"
    }
  }
}
